# Model server used by Omni-MATH, AbstentionBench, and MiP-Overthinking.
SGLANG_BASE_URL=http://127.0.0.1:40000/v1
SGLANG_API_KEY=EMPTY

# Judge API. Use an OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GPT4O_API_KEY=
GPT4O_BASE_URL=
JUDGE_API_KEY=
JUDGE_BASE_URL=

# Optional local paths.
MODEL_PATH=/path/to/local/model
ABSTENTIONBENCH_ROOT=/path/to/official_repo/evaluation/AbstentionBench
MODEL_ROOT=/path/to/models
MEGATRON_LM_PATH=/root/Megatron-LM
